%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Microsoft YaHei, sans-serif", "primaryColor": "#eef4fb", "lineColor": "#555"}}}%%
flowchart TB
  classDef prod fill:#e8f1ff,stroke:#2b6cb0,stroke-width:2px,color:#1a365d
  classDef store fill:#e9f9ef,stroke:#2f855a,color:#22543d
  classDef site fill:#fff7e6,stroke:#c05621,stroke-width:2px,color:#7b341e
  classDef test fill:#fdf0f7,stroke:#97266d,color:#702459
  classDef dead fill:#f1f1f1,stroke:#999,stroke-dasharray:5 5,color:#777

  subgraph SCHED["调度层"]
    TS["任务计划程序<br/>08:30 / 14:30 两轮<br/>错过尽快补跑"]:::prod
    WD["watchdog 计划任务<br/>20h 无成功运行 → 告警<br/>不依赖 ego"]:::prod
  end

  subgraph CORE["编排层（确定性脚本，无 AI）"]
    RC["run_check.py<br/>分站超时 4min / 总超时 25min<br/>taskkill 清理进程树"]:::prod
    CM["core/ 配置·SQLite·去重·关键词<br/>通知·日报"]:::prod
    RC --- CM
  end

  subgraph ADPT["适配器层（每站一个文件，故障隔离）"]
    AGN["国能E招 .py<br/>urllib 静态抓取<br/>列表+详情"]:::prod
    AMJ["华电 / 犀维 .mjs<br/>ego-browser nodejs<br/>bid-* 生产空间"]:::prod
  end

  subgraph DATA["数据与通知"]
    DB[("bid.db SQLite<br/>notified_at 门控：发送成功才落库<br/>VACUUM INTO 备份 ×14")]:::store
    MAIL["邮件到达<br/>agently-cli 主通道 → SMTP 备用<br/>双失败：本地告警 + exit 2"]:::store
  end

  subgraph WEB["真站（公开页面 / 接口）"]
    S1["国能E招<br/>chnenergybidding.com.cn"]:::site
    S2["华电 chdtp.com<br/>瑞数反爬 / iframe"]:::site
    S3["大唐 cdt-ec.com / 犀维 cweme.cn<br/>发布时间窗查询（精确到秒）"]:::site
  end

  TS --> RC
  RC --> AGN --> S1
  RC --> AMJ --> S2
  AMJ --> S3
  RC -->|"新公告 / 告警"| MAIL
  RC -->|"每轮结果"| DB
  RC -->|"日报（固定时间，含计划/实际轮次）"| MAIL
  WD --> MAIL

  subgraph DEVT["开发与测试（人在场；AI 不进生产链路、不碰 bid-* 空间）"]
    AI["Claude Code<br/>写/改适配器、分析页面"]:::test
    DEV["dev-* 未登录空间<br/>小流量探索真站"]:::test
    FIX["tests/fixtures/<br/>真站页面/接口快照（录一次）"]:::test
    UNIT["夹具单测 tests/unit（离线）<br/>解析/清洗/去重/邮件门控<br/>模拟 空列表/报错/改版/截断/投毒"]:::test
    CAL["tests/calibration/&lt;站点&gt;.json<br/>时间窗 + 期望答案<br/>例：2026-06-23 ~ 2026-08-25<br/>含阳城电厂 AGC/AVC/PMU 公告"]:::test
    E2E["标定回归 pytest -m e2e<br/>每站 1–2 次请求<br/>抽取结果 vs 期望答案"]:::test
    MP["mailpit 单容器 docker run<br/>可选：E2E 时 SMTP 断言"]:::test
    CHK["tools/check_redline.py<br/>无 Agent CLI · 域名白名单 · 禁 127.0.0.1"]:::test
  end

  AI -->|"开发"| AMJ
  AI -->|"开发"| AGN
  AI --> DEV
  DEV --> S1
  DEV --> S2
  DEV --> S3
  AI -->|"录制快照"| FIX
  FIX --> UNIT
  CAL --> E2E
  E2E -.->|"验证（改适配器后/发布前）"| AGN
  E2E -.-> AMJ
  MAIL -.->|"E2E 时 SMTP 指向"| MP
  CHK -.->|"上线前自检"| RC

  MOCK["ebid-v2-mockweb/（已封存，不再使用）"]:::dead
