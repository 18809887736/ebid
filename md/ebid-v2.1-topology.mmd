    subgraph DOCKER["docker · ebid-monitor 单容器（Playwright镜像 · shm 1GB · init:true · restart=unless-stopped）"]
        direction TB
        M["main.py 状态槽调度<br/>30s轮询 · slot_runs 当日漏跑补齐<br/>轮次 08:30 / 14:30<br/>轮次失败 try 兜底下轮重试"]:::core
        FL["sites.py · fetch_list ctx<br/>统一契约 native_id / title / pub_date / deadline / url"]:::core
        G1{"一级 · 标题匹配<br/>include 直通 · exclude 排除"}:::core
        G2{"二级 · 已穿透过?<br/>pen_seen 负缓存"}:::store
        FD["fetch_detail 正文穿透<br/>batch_penetrate 触发<br/>正文二次匹配 include"]:::core
        UP["storage.py · upsert_notice<br/>新记录 notified_at=NULL<br/>deadline 变更 is_changed=1 重发"]:::store
        DB[("SQLite ebid.db<br/>notices · slot_runs · pen_seen")]:::store
        PD["待发队列<br/>notified_at IS NULL<br/>发信失败留库 · 下轮自动补发"]:::store
        ML["mailer.py<br/>safe_url 防投毒 · clean_and_escape<br/>主备 SMTP 自动切换"]:::mail

        M -->|每轮 run_job| FL
        FL --> G1
        G1 -->|命中| UP
        G1 -->|命中穿透词| G2
        G2 -->|是 · 跳过| PD
        G2 -->|否| FD
        FD -->|正文命中| UP
        FD -->|未命中 · 记入 pen_seen| DB
        UP --> DB
        DB --> PD
        PD --> ML
    end

    subgraph VOL["宿主机 Volume 热挂载 · 改代码免 rebuild"]
