        V1["./src :ro<br/>适配器源码"]:::vol
        V2["./config.yaml :ro<br/>词库 · 站点开关"]:::vol
        V3["./data rw<br/>ebid.db · app.log"]:::vol
        V4[".env<br/>主备 SMTP 授权码"]:::vol
    end

    subgraph MAIL["邮件输出"]
