        S1["主通道<br/>smtp.qq.com:465"]:::mail
        S2["备通道<br/>smtp.163.com:465"]:::mail
        OB["收件箱<br/>新标提醒 · 08:30 心跳日报<br/>站点异常 ⚠️ 随轮即报"]:::out
    end

