{
  "_comment": "测试环境站点配置：BID_ENV=mock 时加载；${MOCK_BASE}（默认 http://127.0.0.1:18080）由 core/config.py 加载时展开。场景开关不写在这里，经 /__admin 接口切换。",
  "sites": {
    "guoneng": {
      "name": "国能E招",
      "kind": "static",
      "enabled": true,
      "notify": false,
      "base": "${MOCK_BASE}/guoneng/",
      "list_path": "bidweb/001/{cat}/{page}.html",
      "pages": ["moreinfo", "2", "3"],
      "cats": {"001002": "招标公告", "001003": "非招标公告", "001004": "变更公告"},
      "detail_path": "bidweb/001/{cat}/{n}/{ymd}/{slug}.html"
    },
    "chd": {
      "name": "华电",
      "kind": "browser",
      "enabled": true,
      "notify": false,
      "space": "test-chd",
      "entry": "${MOCK_BASE}/chd/pages/wzglS/cgxx/caigou.jsp?cgtype=4",
      "iframe_query": "${MOCK_BASE}/chd/webs/queryWebZbgg.action?zbggType=1&ggbt={keyword}"
    },
    "cweme": {
      "name": "大唐(犀维网)",
      "kind": "browser",
      "enabled": true,
      "notify": false,
      "space": "test-cweme",
      "entry": "${MOCK_BASE}/cweme/cweme-index/webpage/jsp/zbggList.jsp",
      "api": "${MOCK_BASE}/cweme/cweme-index/indexController/getList",
      "types": {"0": "招标公告", "1": "变更公告", "4": "非招标公告"}
    }
  }
}
