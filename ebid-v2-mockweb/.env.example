# 复制为 .env 后按需修改（.env 不入库）
MOCK_PORT=18080
# /__admin/* 与 /__sink/* 的固定 token
MOCK_ADMIN_TOKEN=change-me-local
# 空=使用真实今天；填 YYYY-MM-DD 冻结 mock 的"今天"（测 FRESH_DAYS）
MOCK_TODAY=
# timeout 场景的挂起秒数（默认 120；本机调试可调小）
MOCK_TIMEOUT_SECONDS=120
# mailpit 端口（docker compose --profile mail 启用）
MOCK_SMTP_PORT=18026
MOCK_MAIL_UI_PORT=18025
